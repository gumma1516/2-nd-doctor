# ---------------------------------------------------------------------------
# SecondCare environment
#
# Copy to .env.local and fill in. The app fails fast rather than running
# half-configured: src/lib/firebase.ts throws without the NEXT_PUBLIC_FIREBASE_*
# values, and the payment/assignment routes return 503 until the server
# credentials below are present.
# ---------------------------------------------------------------------------

# Public base URL, used for metadata, sitemap, robots and sign-in link continue URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase web SDK (required) -------------------------------------------
# Firebase console > Project settings > General > Your apps > SDK setup.
# These are public by design; access is enforced by firestore.rules/storage.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Point the browser SDK at the local emulators. Only honoured for a demo-*
# project on a localhost origin; it never redirects a real project.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# --- Firebase Admin (required for payments and case assignment) ------------
# Firebase console > Project settings > Service accounts > Generate new private key.
# Keep the private key on one line with literal \n escapes, wrapped in quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""
# Bucket the server reads report metadata from, e.g. my-project.firebasestorage.app
FIREBASE_ADMIN_STORAGE_BUCKET=
# Alternative to the three values above on Google infrastructure: a credentials
# file path, or nothing at all on Cloud Run, where the default identity is used.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Razorpay (required for checkout) --------------------------------------
# Razorpay dashboard > Account & Settings > API keys, and > Webhooks for the
# secret. Point the webhook at POST /api/payments/webhook and subscribe to
# payment.captured and order.paid. Checkout stays disabled until all three are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
